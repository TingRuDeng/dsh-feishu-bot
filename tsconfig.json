{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noImplicitAny": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationDir": "lib/types",
    "emitDeclarationOnly": true,
    "outDir": "lib",
    "skipLibCheck": true
  },
  "include": ["src"]
}
